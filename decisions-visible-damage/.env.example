# 이 파일을 .env로 복사한 뒤 기존 OpenAI API 키를 설정한다.
# 실제 키가 들어 있는 .env와 .env.local은 Git에 올리지 않는다.
# 환경변수에 이미 설정된 값은 .env 파일로 덮어쓰지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=

# 선택 사항: 키가 저장된 기존 환경 파일의 경로를 지정한다.
# 이 방식을 사용하면 위 OPENAI_API_KEY는 비워 둔다.
# Windows에서도 경로 구분자로 /를 사용할 수 있다.
# 경로에 공백이 있으면 큰따옴표로 감싼다.
# 기존 환경 파일의 키를 읽으며 새 파일에 복사하지 않는다.
OPENAI_ENV_FILE=

# 모델은 app.py의 gpt-6-luna로 고정되어 있다.
# 포트는 환경변수가 아닌 실행 인자로 지정한다: python app.py --port 5053
# 실제 Decisions API 호출에는 API 사용료가 발생한다.
